# Extra response headers for files in public/. Cloudflare reads this file.

# Fonts never change, so browsers can keep them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Keep test and preview copies on workers.dev out of Google. The real domain is not affected.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
