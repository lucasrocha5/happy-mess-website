// Cloudflare settings for the Happy Mess website.
// The Slack address is NOT stored here: it is the SLACK_WEBHOOK_URL secret,
// set in Cloudflare under the Worker's Settings > Variables and Secrets.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "happy-mess-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Unknown addresses show public/404.html
    "not_found_handling": "404-page"
  },
  // Keeps logs so failed form deliveries can be investigated
  "observability": { "enabled": true },
  // Every pull request gets its own preview link on workers.dev (hidden from Google)
  "workers_dev": true,
  "preview_urls": true,
  "previews": {}
}
